# Copy this file to .env, then fill in your own MySQL credentials.
# Never commit the real .env.

# --- Database (MySQL) ---
# Example after creating your DB (see README "Setup" section):
DATABASE_URL=mysql+pymysql://voiceapp:CHANGE_ME@localhost:3306/voice_security

APP_NAME=voice-deepfake-detection-api
APP_ENV=development
DEBUG=false

ALLOWED_ORIGINS=http://localhost:3000

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=25

# --- API Authentication ---
# Pre-generated key, ready to use as-is, or regenerate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=CHANGE_ME

# --- ML Service integration (leave empty until the ML teammate provides a URL) ---
ML_SERVICE_URL=

RISK_THRESHOLD_SUSPICIOUS=40
RISK_THRESHOLD_HIGH=70
